{
  "name": "shieldbar",
  "version": "1.0.0",
  "private": true,
  "description": "Public IP and WebRTC leak monitor for the Windows and Linux system tray",
  "author": "TH3L30 <its.mani.brz@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/TH3L30/ShieldBar",
  "desktopName": "ShieldBar.desktop",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "self-test": "npm run build && electron . --self-test",
    "smoke": "npm run build && electron . --smoke-test",
    "preview": "npm run build && electron . --render-preview",
    "icons": "node scripts/generate-icons.mjs",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
